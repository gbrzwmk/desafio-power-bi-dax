table F_Vendas
	lineageTag: f486ab73-9fab-4827-ae50-bd4eb52fa53c

	measure 'Total de Vendas' = SUM(F_Vendas[Sales])
		formatString: #,0.00
		lineageTag: c177f113-1e78-4196-b24f-3e81f453324e

	measure 'Total de Lucro' = SUM(F_Vendas[Profit])
		formatString: #,0.00
		lineageTag: f129c8c6-d1ca-4dc4-adfd-e4163eff8b3f

	measure 'Unidades Vendidas' = SUM(F_Vendas[Units Sold])
		formatString: #,0
		lineageTag: 5ad3ba32-8332-405a-9829-681876531737

	measure 'Qtd de Vendas' = COUNTROWS(F_Vendas)
		formatString: #,0
		lineageTag: c68deb5d-403a-460a-8652-dbd0e488b6c8

	measure 'Margem de Lucro' = DIVIDE([Total de Lucro], [Total de Vendas])
		formatString: 0.0%
		lineageTag: bf9703c0-96fa-4b7b-9ba9-5a54767d5274

	measure 'Ticket Médio' = DIVIDE([Total de Vendas], [Qtd de Vendas])
		formatString: #,0.00
		lineageTag: dc14ed57-5e07-40b3-8c17-0c31c7eec61b

	measure 'Preço Médio de Venda' = AVERAGE(F_Vendas[Sale Price])
		formatString: #,0.00
		lineageTag: f21ff5eb-6ed7-4f5d-8960-afe94bbdbb01

	measure 'Total de Descontos' = SUM(D_Descontos[Discount])
		formatString: #,0.00
		lineageTag: 573ac59a-355f-4af4-9757-905efa749692

	measure 'Vendas Brutas' = SUM(D_Detalhes[Gross Sales])
		formatString: #,0.00
		lineageTag: eb07c30d-5cd5-461c-9c5f-319e834c1b69

	measure 'Custo Total (COGS)' = SUM(D_Detalhes[COGS])
		formatString: #,0.00
		lineageTag: ec983704-4692-4a03-9707-967025f02628

	measure 'Vendas Ano Anterior' = CALCULATE([Total de Vendas], SAMEPERIODLASTYEAR('D_Calendário'[Date]))
		formatString: #,0.00
		lineageTag: 4ffcbf42-1792-4e6c-8b8e-8f4eb3de08f9

	measure 'Vendas Acumuladas no Ano' = TOTALYTD([Total de Vendas], 'D_Calendário'[Date])
		formatString: #,0.00
		lineageTag: 2d6f2efc-4e61-4a36-9119-cdccaf9b74f8

	measure 'Variação vs Ano Anterior' = DIVIDE([Total de Vendas] - [Vendas Ano Anterior], [Vendas Ano Anterior])
		formatString: 0.0%
		lineageTag: 261c374b-a076-47d6-9404-ab1ecc7c6d81

